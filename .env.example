# SplitWay 环境变量样板
#
# 用法：cp .env.example .env，然后把下面每一项的 <...> 占位符换成真实值。
# 规则（#1 / 团队分工书 硬约束 3）：
#   - 本文件只提交占位符，不含任何真实口令 / 密钥；
#   - .env 已被 .gitignore 忽略，永不入库；
#   - 凭据类变量缺失或为空时，后端启动即失败，不提供默认值。

# ---- 数据库（供 docker compose 的 db 服务与连接串拼接使用）----
POSTGRES_USER=<数据库用户名>
POSTGRES_PASSWORD=<数据库口令>
POSTGRES_DB=<数据库名>

# DATABASE_URL 由 docker-compose.yml 用上面三项拼成，不需要在这里设置。
# 后端容器内会收到形如 postgresql+psycopg://<user>:<password>@db:5432/<db> 的连接串。

# ---- 后端 ----
# JWT 签名密钥：至少 32 字符的随机串；缺失或过短则后端启动失败。
JWT_SECRET=<至少 32 字符的随机串>

# CORS 白名单：逗号分隔；禁止使用 "*"（用了会在启动时直接失败）。
# 默认值与 architecture.md §1.1 一致，供本机 npm run dev 调试。
CORS_ORIGINS=http://localhost:5173

# 房间人数上限（不含房主），默认 20，配置可改（decisions.md D11）。
ROOM_MEMBER_LIMIT=20

# ---- 前端 ----
# 前端容器对外端口，容器内固定监听 80。
FRONTEND_PORT=8080
