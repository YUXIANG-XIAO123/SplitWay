# SplitWay 环境变量样例。
# 复制为 .env 后按需修改：cp .env.example .env
# 说明：本文件只包含占位符，任何真实凭据都不允许提交到仓库。

# ---- 数据库（PostgreSQL 16）----
POSTGRES_USER=splitway
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=splitway
DB_PORT=5432

# ---- 后端 ----
BACKEND_PORT=8000
# 必填：JWT 签名密钥。请替换为足够长的随机串；无默认值，缺失则后端启动失败。
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# CORS 白名单，逗号分隔，禁止使用 '*'
CORS_ORIGINS=http://localhost:5173
# 房间人数上限（不含房主）
ROOM_MEMBER_LIMIT=20

# ---- 前端 ----
FRONTEND_PORT=8080
